AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-sol

# Optional alternatives:
# AI_PROVIDER=mistral
# MISTRALKEY=your_mistral_api_key
# MISTRAL_MODEL=mistral-small-2506

# Optional shared secret between the extension and backend:
# HOVERGPT_TOKEN=change-me

# Extension endpoint defaults are in extension.env.
# Copy extension.env.example to extension.env and edit HOVERGPT_REMOTE_API_URL.
